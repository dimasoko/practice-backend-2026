            "put": {
                "tags": [
                    "Surveys"
                ],
                "summary": "Обновить опрос (только черновик и автор)",
                "operationId": "004b5441c458eb1e748628dff71f780f",
                "parameters": [
                    {
                        "name": "survey",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "title": {
                                        "type": "string",
                                        "example": "Обновленное название"
                                    },
                                    "description": {
                                        "type": "string",
                                        "example": "Новое описание"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Опрос обновлен",
                        "content": {
                            "application/json": {
                                "schema": {
